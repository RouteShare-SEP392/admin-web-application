# Runtime uses real Backend APIs only; legacy mock mode is disabled in code.
NEXT_PUBLIC_API_MOCK=off

# Endpoint GraphQL của RouteShare Backend (chỉ dùng phía server của Next.js)
BACKEND_GRAPHQL_URL=http://localhost:3000/graphql

# Public Goong Map tiles key only. Never use GOONG_API_KEY (server Places/Direction).
NEXT_PUBLIC_GOONG_MAPTILES_KEY=
