# Chế độ dữ liệu mẫu:
#   all     - mọi thao tác chạy trên dữ liệu mẫu, không cần backend (mặc định)
#   missing - API backend đã có thì gọi thật, API chưa có thì dùng dữ liệu mẫu
#   off     - gọi backend cho mọi thao tác
NEXT_PUBLIC_API_MOCK=all

# Endpoint GraphQL của RouteShare Backend (chỉ dùng phía server của Next.js)
BACKEND_GRAPHQL_URL=http://localhost:3000/graphql
